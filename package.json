    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "engines": { "node": ">=20" },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
